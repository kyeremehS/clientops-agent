# Copy to .env — never commit real values
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/clientops
BACKEND_PORT=8000
FRONTEND_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# LLM (LLM_PROVIDER=openrouter|groq|openai; set the model for the provider)
LLM_PROVIDER=openrouter
LLM_MODEL=google/gemma-4-31b-it:free
OPENROUTER_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
# Slack (Slice 1: test workspace, fixed channel)
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
# Research (Slice 2: search provider + keys; mock needs no key)
SEARCH_PROVIDER=mock
PARALLEL_API_KEY=
TAVILY_API_KEY=
SERPER_API_KEY=
